# Copy to .env. docker-compose.yml starts SeaweedFS with these credentials
# and creates the bucket. Point the LAKE_S3_* values at another
# S3-compatible endpoint to run the pipeline against it instead.
LAKE_S3_ENDPOINT=127.0.0.1:8333
LAKE_S3_REGION=us-east-1
LAKE_S3_USE_SSL=false
LAKE_S3_URL_STYLE=path
LAKE_S3_BUCKET=lake
LAKE_S3_ACCESS_KEY_ID=lake
LAKE_S3_SECRET_ACCESS_KEY=local-dev-only-change-me

# Free key from https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Where dbt finds its project and profile. dbt doesn't read .env itself, so
# run it through dotenv from the repository root: dotenv run -- dbt build
DBT_PROJECT_DIR=dbt
DBT_PROFILES_DIR=dbt

# DuckDB only holds views over the Parquet in the lake, but the path has to be
# absolute: a relative one resolves against each process's working directory,
# which silently gives a shell and a Dagster run two different databases.
# LAKE_DUCKDB_PATH=/absolute/path/to/macro-vintage-lakehouse/lake.duckdb

# Dagster's storage directory. It has to be an absolute path, so set it to
# this repository's dagster_home folder on your machine before `dagster dev`.
# DAGSTER_HOME=/absolute/path/to/macro-vintage-lakehouse/dagster_home
